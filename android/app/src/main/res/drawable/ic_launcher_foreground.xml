<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal prompt motif: green ">_" with a block cursor, on a dark CRT field. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- CRT scanline hint: a very subtle top glow bar -->
    <path
        android:fillColor="#14322A"
        android:pathData="M0,0 L108,0 L108,14 L0,14 Z" />

    <!-- ">" chevron -->
    <path
        android:strokeColor="#00E436"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M34,38 L48,54 L34,70" />

    <!-- "_" underscore -->
    <path
        android:strokeColor="#00E436"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M52,74 L68,74" />

    <!-- block cursor -->
    <path
        android:fillColor="#FFCCAA"
        android:pathData="M74,67 L82,67 L82,75 L74,75 Z" />
</vector>
