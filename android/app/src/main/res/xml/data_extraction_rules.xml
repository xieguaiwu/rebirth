<?xml version="1.0" encoding="utf-8"?>
<!-- Disable cloud backup and device-to-device transfer (LLM keys never leave the device). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
