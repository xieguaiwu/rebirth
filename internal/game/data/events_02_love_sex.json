[
  {"id":"first_love","text":"初恋像一场低烧，好了以后你再也记不得疼在哪。","min_age":15,"max_age":24,"weight":9,"delta":{"spr":1,"chr":0.5},"trauma_alpha":0.05},
  {"id":"betrayed_love","text":"你在TA的手机里看到了答案。此后很多年你都睡得很浅。","min_age":17,"max_age":35,"weight":6,"delta":{"spr":-2},"trauma_alpha":0.2},
  {"id":"first_time_tender","text":"第一次。笨拙、紧张、笑场，但温柔是真的。","min_age":16,"max_age":25,"weight":6,"good":true,"cond":{"min_chr":3},"delta":{"spr":1.5}},
  {"id":"first_time_awful","text":"第一次很糟糕：疼、慌、想逃。你花了很多年才重新学会期待。","min_age":16,"max_age":28,"weight":4,"delta":{"spr":-1.5},"trauma_alpha":0.15},
  {"id":"one_night_stand","text":"陌生人的床、清晨的尴尬、和一种奇异的自由感。","min_age":18,"max_age":45,"weight":5,"cond":{"min_chr":4},"delta":{"spr":0.5}},
  {"id":"friends_with_benefits","text":"你们约法三章：不谈感情。第三章最先碎。","min_age":18,"max_age":40,"weight":5,"delta":{"spr":-0.5},"trauma_alpha":0.05},
  {"id":"long_distance_love","text":"异地的爱靠时差和流量活着。视频挂断后的房间格外安静。","min_age":18,"max_age":40,"weight":5,"delta":{"spr":-0.5}},
  {"id":"affair_guilt","text":"婚外的秘密像含在嘴里的冰，化得比你想的快。","min_age":26,"max_age":55,"weight":3,"delta":{"spr":-1},"trauma_alpha":0.1},
  {"id":"open_relationship","text":"你们谈开了规则。嫉妒没有消失，但诚实多了。","min_age":22,"max_age":45,"weight":2,"good":true,"delta":{"spr":0.5}},
  {"id":"asexuality_realize","text":"你终于找到那个词了。不是坏掉，是不一样——世界原来有这么多种活法。","min_age":16,"max_age":35,"weight":2,"good":true,"therapy_q":0.2,"delta":{"spr":1.5}},
  {"id":"coming_out_family","text":"出柜那晚，母亲沉默了很久，然后给你夹了一筷子菜。有些接受是无声的。","min_age":16,"max_age":35,"weight":2,"good":true,"delta":{"spr":1.5},"therapy_q":0.15},
  {"id":"coming_out_reject","text":"他们说「治治就好了」。你搬出去的那天没回头。","min_age":16,"max_age":30,"weight":2,"delta":{"spr":-2},"trauma_alpha":0.2},
  {"id":"kink_discovery","text":"你在安全词的边界内找到了一种奇怪的安宁：把控制交出去的那一刻，反而自由。","min_age":20,"max_age":50,"weight":2,"good":true,"delta":{"spr":1}},
  {"id":"kink_boundary_broken","text":"对方越过了说好的界限。事后TA道歉了，但你身体里的警报再也没关掉过。","min_age":20,"max_age":50,"weight":2,"delta":{"spr":-2.5},"trauma_alpha":0.25},
  {"id":"sti_scare","text":"等待检测结果的两周，你把人生倒带重放了一遍。阴性。你发誓再也不心存侥幸。","min_age":18,"max_age":55,"weight":4,"delta":{"spr":-1},"therapy_q":0.05},
  {"id":"sti_positive","text":"确诊那天你在医院楼梯间坐到天黑。慢性病管理、告知伴侣、重新开始——你都做到了。","min_age":18,"max_age":55,"weight":2,"delta":{"spr":-2},"trauma_alpha":0.15,"therapy_q":0.1},
  {"id":"contraception_fail","text":"验孕棒上两道杠。你们在便利店门口坐了很久，谁都没说话。","min_age":18,"max_age":38,"weight":3,"delta":{"spr":-1.5},"trauma_alpha":0.1},
  {"id":"abortion_decision","text":"手术室外你握着TA的手。这个决定没有对错，只有承受。","min_age":18,"max_age":40,"weight":2,"delta":{"spr":-2},"trauma_alpha":0.175},
  {"id":"unplanned_keep","text":"你们决定留下TA。恐慌和期待轮流值班，直到第一声胎心把一切压平。","min_age":20,"max_age":38,"weight":2,"good":true,"delta":{"spr":1}},
  {"id":"sexual_dysfunction_m","text":"身体在关键时刻背叛了你。药盒藏在袜子抽屉最深处，像一个耻辱的存档点。","min_age":30,"max_age":75,"weight":3,"delta":{"spr":-1.5,"chr":-0.5},"trauma_alpha":0.1},
  {"id":"sexual_pain_w","text":"每次都疼，每次都说没事。直到那位女医生说：「这不是你的错，是可以治的。」","min_age":18,"max_age":60,"weight":3,"delta":{"spr":-1.5},"trauma_alpha":0.125,"therapy_q":0.2},
  {"id":"libido_mismatch","text":"一个想要，一个疲惫。卧室慢慢变成了客房。","min_age":28,"max_age":65,"weight":4,"delta":{"spr":-1}},
  {"id":"sex_ed_late","text":"二十岁了你才第一次看到正确的性教育材料。你气的是那些年被谎话占用的年份。","min_age":18,"max_age":30,"weight":2,"delta":{"int":0.5},"trauma_alpha":0.05},
  {"id":"harassment_street","text":"口哨、注视、跟了两条街的脚步声。你把钥匙夹在了指缝里。","min_age":14,"max_age":60,"weight":5,"delta":{"spr":-1},"trauma_alpha":0.15},
  {"id":"harassment_workplace","text":"他的手「不小心」。你辞职了，他升职了。十年后你在新闻上看到了他的名字和罪名。","min_age":18,"max_age":55,"weight":3,"delta":{"spr":-2.5},"trauma_alpha":0.25},
  {"id":"assault_survive","text":"那件事之后你洗了很久的澡。后来一位咨询师对你说：脏的从来不是你。","min_age":14,"max_age":55,"weight":2,"delta":{"spr":-3.5},"trauma_alpha":0.325},
  {"id":"assault_justice","text":"判决下来了。正义迟到但不缺席——你在法庭外哭到蹲下去，是这十年第一次哭出声。","min_age":16,"max_age":60,"weight":1,"good":true,"therapy_q":0.4,"delta":{"spr":1.5},"trauma_alpha":0.05},
  {"id":"intimacy_after_trauma","text":"又过了一年，你第一次允许有人靠近。心跳如鼓，但没有逃。","min_age":18,"max_age":60,"weight":3,"good":true,"therapy_q":0.45,"delta":{"spr":2}},
  {"id":"consent_education","text":"你开始在网上做 Consent 科普。私信里有人说：谢谢你，我昨天说了不。","min_age":18,"max_age":60,"weight":2,"good":true,"therapy_q":0.2,"delta":{"spr":1}},
  {"id":"sugar_dating","text":"糖衣的关系：他买单，你陪笑。账目清楚，唯独自尊没法开发票。","min_age":18,"max_age":40,"weight":2,"cond":{"min_chr":6},"delta":{"mny":1.5,"spr":-1},"trauma_alpha":0.125},
  {"id":"polyamory_found","text":"三个人，四份日历，无数场谈话。爱的容量原来可以商量。","min_age":22,"max_age":50,"weight":1,"good":true,"delta":{"spr":0.5}},
  {"id":"loveless_marriage","text":"婚姻还在运转，像一台没人敢关的老机器。","min_age":35,"max_age":70,"weight":3,"delta":{"spr":-1}},
  {"id":"late_in_life_love","text":"七十岁的黄昏恋。子女反对，你们还是牵了手——公园长椅上的两只手都是皱的。","min_age":65,"max_age":95,"weight":2,"good":true,"delta":{"spr":2}},
  {"id":"romance_novel_escape","text":"言情小说是你的止痛药。明知是糖精，还是戒不掉那一口甜。","min_age":14,"max_age":60,"weight":3,"delta":{"spr":0.5}},
  {"id":"dating_app_fatigue","text":"左滑右滑三百次后，你卸载了APP。孤独没有被优化，反而被量化了。","min_age":20,"max_age":45,"weight":4,"delta":{"spr":-0.5}},
  {"id":"rekindled_flame","text":"同学会上重逢。二十年过去，你们聊了十分钟就像从没分开过。","min_age":38,"max_age":70,"weight":2,"good":true,"delta":{"spr":1.5}},
  {"id":"cheat_discovered","text":"聊天记录被投影到了家庭聚会的电视上——孩子误触的投屏。世界安静了三秒。","min_age":28,"max_age":60,"weight":2,"delta":{"spr":-3},"trauma_alpha":0.225},
  {"id":"celibacy_vow","text":"你决定暂停一切亲密关系，一年。第三个月开始睡得很好。","min_age":22,"max_age":55,"weight":2,"good":true,"therapy_q":0.25,"delta":{"spr":1}},
  {"id":"body_image_heal","text":"你在镜子里多站了一会儿，第一次没有挑剔。皮肤、疤痕、赘肉——都是活着的证据。","min_age":16,"max_age":70,"weight":3,"good":true,"therapy_q":0.3,"delta":{"spr":1.5}}
