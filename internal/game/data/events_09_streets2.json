[
  {"id":"sanhe_geopolitics","text":"桥洞下的国际形势研讨会开到凌晨两点：中美俄三角关系，主讲人三天没吃早饭。","min_age":18,"max_age":45,"weight":4,"cond":{"max_mny":2},"delta":{"spr":0.8,"mny":-0.1},"trauma_alpha":0.05},
  {"id":"sanhe_bed_15","text":"十五块的挂逼床位，八人间，鼾声、脚臭和梦话里的「老板再给一次机会」。","min_age":17,"max_age":45,"weight":4,"cond":{"max_mny":2},"delta":{"str":-0.3,"spr":-0.5}},
  {"id":"sanhe_last_guard","text":"你成了园区最后一个保安。铁门内外，大神来了又走，你是唯一的常量。","min_age":35,"max_age":60,"weight":2,"cond":{"max_mny":4},"delta":{"mny":0.3,"spr":-0.3}},
  {"id":"flow_chosen_viral","text":"镜头选中了你。一夜之间你的脸挂在百万人的屏幕上——他们叫你「最后的XX」。","min_age":16,"max_age":50,"weight":2,"good":true,"context":"famous","delta":{"chr":0.5,"spr":1.5}},
  {"id":"flow_crowded_watch","text":"网红们扛着设备来拍你的日常。买你时间的人比关心你的人多。","min_age":16,"max_age":52,"weight":5,"requires":["famous"],"delta":{"mny":0.8,"spr":-1.5},"trauma_alpha":0.25},
